# Django Settings
SECRET_KEY=your-secret-key-here-min-50-characters
DEBUG=False
DJANGO_SETTINGS_MODULE=fergani.settings

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,your-app.up.railway.app

# CSRF trusted origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://your-app.up.railway.app

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com
